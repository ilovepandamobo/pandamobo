# preview：开发预览，可显示未批准指标，并带来源角标。
# production：只输出已批准的公开内容。正式发布请使用 production。
CONTENT_MODE=preview

# 可选。未配置时不生成绝对 canonical。
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# 正式模式下，咨询表单把已同意提交的数据 POST 给企业接收端。
# 接收端应使用 HTTPS 并在接受该线索后返回 2xx。
# CONSULT_WEBHOOK_URL=https://your-lead-receiver.example/consult
# CONSULT_WEBHOOK_TOKEN=
